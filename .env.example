# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAA-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adminlarning Telegram ID raqamlari (vergul bilan). ID ni @userinfobot dan bilish mumkin
ADMIN_IDS=111111111,222222222

# "Admin bilan bog'lanish" bo'limida ko'rsatiladigan username (ixtiyoriy, @ siz)
ADMIN_USERNAME=admin_username

# Majburiy obuna kanali. @kanal_nomi yoki -100xxxxxxxxxx ko'rinishida.
# Bot shu kanalga ADMIN qilib qo'shilishi SHART. Bo'sh qoldirilsa tekshirilmaydi.
CHANNEL_ID=@kanal_nomi
# Yopiq kanal bo'lsa taklif havolasini yozing (ochiq kanalda avtomatik)
CHANNEL_URL=

# Loglar yoziladigan MAXFIY kanal ID si (-100... ko'rinishida). Bot shu kanalga admin qilinadi.
# Bo'sh qoldirilsa loglar yozilmaydi. ID ni bilish: kanalga biror xabar yozib, uni @userinfobot ga forward qiling.
LOG_CHANNEL_ID=
# Necha daqiqa harakatsizlikdan keyin yangi sessiya (yangi log xabari) boshlanadi
LOG_SESSION_MINUTES=30

# Mini ilova: tashqaridan ochiladigan HTTPS manzil (masalan https://bot.example.uz)
# Railway'da bo'sh qoldiring — domen (RAILWAY_PUBLIC_DOMAIN) avtomatik olinadi
WEBAPP_URL=
# Mini ilova serveri porti. Railway'da YOZMANG — Railway o'zi beradi
PORT=3000

# Vaqt mintaqasi (reytingdagi hafta/oy hisobi uchun)
TZ=Asia/Tashkent

# ---------------- BAZA ----------------
# Lokal: SQLite (hech narsa yozmasangiz shu ishlaydi)
SQLITE_FILE=./data/bot.sqlite

# Server / Railway: MySQL. Quyidagilardan BIRINI bersangiz bot o'zi MySQL ga o'tadi:
#  a) bitta qator:  MYSQL_URL=mysql://user:parol@host:3306/baza
#     Railway'da:   MYSQL_URL=${{MySQL.MYSQL_URL}}   (Variables bo'limida, reference sifatida)
#  b) alohida:      MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
MYSQL_URL=
# Majburan tanlash kerak bo'lsa: DB_CLIENT=mysql yoki DB_CLIENT=sqlite
DB_CLIENT=
